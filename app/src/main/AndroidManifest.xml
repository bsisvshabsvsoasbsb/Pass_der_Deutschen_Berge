<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bewusst keine Berechtigungen: die App arbeitet vollstaendig offline.
         Keine INTERNET-Permission, keine Standortabfrage, keine Analytics. -->

    <application
        android:name=".PassApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locale_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.PassDerDeutschenBerge">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.PassDerDeutschenBerge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
